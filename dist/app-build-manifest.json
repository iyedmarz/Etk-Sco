{
  "pages": {
    "/layout": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/layout.css",
      "static/chunks/app/layout.js"
    ],
    "/[locale]/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/[locale]/page.css",
      "static/chunks/app/[locale]/page.js"
    ],
    "/[locale]/layout": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/[locale]/layout.js"
    ],
    "/[locale]/(routes)/layout": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/[locale]/(routes)/layout.css",
      "static/chunks/app/[locale]/(routes)/layout.js"
    ],
    "/[locale]/(routes)/checkout/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/[locale]/(routes)/checkout/page.css",
      "static/chunks/app/[locale]/(routes)/checkout/page.js"
    ],
    "/[locale]/(routes)/codePromo/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/[locale]/(routes)/codePromo/page.js"
    ],
    "/[locale]/(routes)/codePromo/saisirManuel/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/[locale]/(routes)/codePromo/saisirManuel/page.css",
      "static/chunks/app/[locale]/(routes)/codePromo/saisirManuel/page.js"
    ]
  }
}